export const verifyApiKeysLoaded = () => {
  if (!API_KEYS.googleApiKey) console.warn("Google API Key is missing!");
  if (!API_KEYS.telegramBotToken) console.warn("Telegram Token is missing!");
  return API_KEYS;
};
import openwakeword
from openwakeword.model import Model
import pyaudio
import numpy as np
import requests

# 1. Initialize with your custom 'Project Aman Kumar' model
# Ensure the "models" directory exists and has "hey_aman.onnx" inside it
model = Model(wakeword_models=["models/hey_aman.onnx"])

# Set up microphone audio stream using PyAudio
CHUNK = 1280
FORMAT = pyaudio.paInt16
CHANNELS = 1
RATE = 16000

audio = pyaudio.PyAudio()
mic_stream = audio.open(format=FORMAT, channels=CHANNELS, rate=RATE, input=True, frames_per_buffer=CHUNK)

def start_listening_for_command():
    print("🤖 Aman is listening... What can I do for you?")
    # Example: you could send a request to your backend here
    # response = requests.post("http://localhost:5000/command", json={"status": "listening"})
    # print(response.json())

print("Listening for wake word 'Hey Aman'...")

# Continuous loop for Persistent Listening
try:
    while True:
        # Get audio_frame from your microphone capture layer
        audio_data = mic_stream.read(CHUNK, exception_on_overflow=False)
        audio_frame = np.frombuffer(audio_data, dtype=np.int16)

        # Feed the audio frame into the model
        prediction = model.predict(audio_frame)

        # Threshold for detection
        # If the confidence is high enough, trigger the command logic
        if prediction["hey_aman"] > 0.6: 
            start_listening_for_command()

except KeyboardInterrupt:
    print("\nStopping listener...")
finally:
    # Clean up the audio stream when exiting
    mic_stream.stop_stream()
    mic_stream.close()
    audio.terminate()


